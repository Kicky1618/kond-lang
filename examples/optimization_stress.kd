// A compact smoke test for the built-in ExactEq optimizer and the standard
// proof-checked optimization library.
fn main() {
    let x = 42
    print(x + 0)
    print(0 + x)
    print(x * 0)
    print(0 * x)
    print(x & 0)
    print(x | 0)
    print(x ^ x)
    print(x / x)
    print(x % x)
    print(abs(x))
    print(std.math.min(x, x))
    print(std.list.reverse(std.list.reverse([1, 2, 3])))
    print((2 + 3) * 4)
    print(std.string.uppercase("kond"))
    print(std.list.length(std.core.range(0, 10, 2)))
    print(std.list.length(std.core.repeat(9, 1000000)))
    print(std.list.length(std.list.concat([1, 2], [3])))
    print(std.list.length(std.list.reverse([1, 2, 3])))
    print(std.list.length(std.list.sort([3, 1, 2])))
    print(std.list.length(std.list.zip([1, 2, 3], [4, 5])))
    print(std.list.length(std.list.slice([1, 2, 3, 4], 1, 3)))
    print(std.string.length(std.string.repeat("ab", 4)))
    print(std.list.length(std.list.append([1, 2], 3)))
    print(std.string.length(std.string.reverse("abc")))
    print(std.map.length(std.map.put({"a": 1}, "b", 2)))
    print(len(std.map.remove({"a": 1}, "a")))
    print(std.map.size(std.map.merge({"a": 1}, {"a": 2, "b": 3})))
}
